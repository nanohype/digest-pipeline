# ─── WorkOS AuthKit ───
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_01ABC...
WORKOS_COOKIE_PASSWORD=generate-a-random-string-of-at-least-32-chars
# AuthKit reads this from NEXT_PUBLIC_WORKOS_REDIRECT_URI (Next.js inlines
# NEXT_PUBLIC_* values at build time — see Dockerfile.web's build ARG).
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# ─── DigestPipeline API ───
# Base URL of the digest-pipeline Fastify API. Locally that's :3001; in-cluster
# it's the api Service DNS (digest-pipeline-api.tenants-protohype.svc.cluster.local:3001).
API_BASE_URL=http://localhost:3001

# ─── OpenTelemetry ───
# OTLP endpoint (server-side). In-cluster this is the shared collector
# (otel-collector.observability.svc.cluster.local:4318). The browser SDK posts
# to /api/otel/v1/traces, which proxies here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=digest-pipeline-web
# OTEL_SDK_DISABLED=true
