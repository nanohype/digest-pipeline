{
  "uid": "digest-pipeline",
  "title": "DigestPipeline",
  "tags": [
    "growth",
    "digest-pipeline"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(digest_pipeline_run_duration_seconds_bucket, deployment_environment)",
        "current": {
          "text": "production",
          "value": "production"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "SLO \u2014 pipeline run success (99% over 30d)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Run success (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Successful runs / total over 30d vs the 99% objective. status SUCCESS vs PARTIAL|FAILED.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(increase(digest_pipeline_run_duration_seconds_count{status=\"SUCCESS\",deployment_environment=\"$environment\"}[30d])) / clamp_min(sum(increase(digest_pipeline_run_duration_seconds_count{deployment_environment=\"$environment\"}[30d])), 1)"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "gauge",
      "title": "Error budget remaining (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Fraction of the 30-day 1% run-failure budget still unspent.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "clamp_min(1 - ((sum(increase(digest_pipeline_run_duration_seconds_count{status=~\"PARTIAL|FAILED\",deployment_environment=\"$environment\"}[30d])) / clamp_min(sum(increase(digest_pipeline_run_duration_seconds_count{deployment_environment=\"$environment\"}[30d])), 1)) / 0.01), 0)"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Failed/partial runs (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Count of non-SUCCESS runs in the window.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "expr": "sum(increase(digest_pipeline_run_duration_seconds_count{status=~\"PARTIAL|FAILED\",deployment_environment=\"$environment\"}[30d]))"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "id": 1,
      "title": "Pipeline run \u2014 outcomes (last 4 weeks)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(digest_pipeline_run_duration_seconds_count{deployment_environment=\"$environment\"}[28d]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Pipeline run \u2014 duration p50 / p95",
      "type": "timeseries",
      "description": "SLO: p95 <= 10 min (600 s). Source: OTel histogram digest_pipeline_run_duration_seconds. Unit is seconds, matching the series and the 600 in the alert \u2014 a panel declaring ms renders a threshold breach as '640 ms', which reads as excellent.",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(digest_pipeline_run_duration_seconds_bucket{deployment_environment=\"$environment\"}[28d])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(digest_pipeline_run_duration_seconds_bucket{deployment_environment=\"$environment\"}[28d])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 3,
      "title": "Sources \u2014 items per run",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (source) (increase(digest_pipeline_source_items_total{deployment_environment=\"$environment\"}[7d]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Sources \u2014 failures per run",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (source) (increase(digest_pipeline_source_failure_total{deployment_environment=\"$environment\"}[7d]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Bedrock \u2014 tokens per run",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (kind, model) (increase(digest_pipeline_bedrock_tokens_total{deployment_environment=\"$environment\"}[28d]))",
          "legendFormat": "{{model}} / {{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "title": "Bedrock \u2014 fallbacks (any value >0 is bad)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(digest_pipeline_bedrock_fallback_total{deployment_environment=\"$environment\"}[28d]))",
          "legendFormat": "fallbacks (28d)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Edit rate per run (Levenshtein vs auto-baseline)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (run_id) (digest_pipeline_draft_edit_rate{deployment_environment=\"$environment\"})",
          "legendFormat": "{{run_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 8,
      "title": "Email sends per run",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(digest_pipeline_email_sent_total{deployment_environment=\"$environment\"}[28d]))",
          "legendFormat": "sends (28d)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    }
  ]
}
