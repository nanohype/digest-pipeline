{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "noEmit": true,
    "sourceMap": true,
    "isolatedModules": true,
    "declaration": false,
    "allowSyntheticDefaultImports": true
  },
  // evals/ is typechecked here but not built: vitest runs evals/**/*.test.ts on
  // every PR and never typechecks anything, so without this the eval tier is the
  // one place where a stale fixture shape or a wrong grader signature is
  // invisible until the model tier runs. tsconfig.build.json narrows emit back
  // to src/.
  "include": ["src/**/*", "evals/**/*"],
  "exclude": ["node_modules", "dist", ".next", "web"]
}
