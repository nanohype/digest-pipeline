# syntax=docker/dockerfile:1.9

# ─── build stage ───
FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
# `npm install` over `npm ci`: the lockfile is generated on macOS and omits
# Linux platform-conditional optional deps (vitest/rolldown bindings) that
# resolve only on the Linux build platform. Version pinning still comes from
# the lockfile.
RUN --mount=type=cache,target=/root/.npm npm install --prefer-offline --no-audit --no-fund

COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npx tsc -p tsconfig.build.json

RUN npm prune --omit=dev

# ─── runtime stage ───
FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001

RUN addgroup -S digest-pipeline && adduser -S digest-pipeline -G digest-pipeline

COPY --from=build --chown=digest-pipeline:digest-pipeline /app/node_modules ./node_modules
COPY --from=build --chown=digest-pipeline:digest-pipeline /app/dist ./dist
COPY --from=build --chown=digest-pipeline:digest-pipeline /app/package.json ./package.json

EXPOSE 3001
USER digest-pipeline

# dist/api/entrypoint.js is the composition root: it wires the Postgres
# repositories, audit writer, SES sender, and Slack confirmer, then starts
# the Fastify server.
CMD ["node", "--import=./dist/common/otel-bootstrap.js", "--enable-source-maps", "dist/api/entrypoint.js"]
