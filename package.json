{
  "name": "digest-pipeline",
  "version": "0.1.0",
  "description": "Automated weekly newsletter pipeline — aggregates GitHub/Linear/Notion/Slack, drafts with Bedrock, WorkOS-gated approval and SES send",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:pipeline": "tsx watch src/pipeline/entrypoint.ts",
    "dev:api": "tsx watch src/api/entrypoint.ts",
    "start:pipeline": "node --enable-source-maps dist/pipeline/entrypoint.js",
    "start:api": "node --enable-source-maps dist/api/entrypoint.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run --config vitest.eval.config.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "platform:validate": "node scripts/validate-platform-manifests.mjs && node scripts/validate-platform-manifests.mjs --self-test",
    "sync:vendored": "node scripts/sync-vendored.mjs",
    "sync:vendored:check": "node scripts/sync-vendored.mjs --check",
    "sync:vendored:freshness": "node scripts/sync-vendored.mjs --freshness",
    "sync:vendored:selftest": "node scripts/sync-vendored.mjs --self-test",
    "schemas:sync": "node scripts/sync-crd-schemas.mjs",
    "schemas:check": "node scripts/sync-crd-schemas.mjs --check",
    "schemas:freshness": "node scripts/sync-crd-schemas.mjs --freshness",
    "docs": "echo 'Docs: README.md, AGENTS.md, ARCHITECTURE.md, docs/'",
    "migrate:up": "node dist/data/migrate.js up",
    "migrate:down": "node dist/data/migrate.js down",
    "dev:migrate:up": "tsx src/data/migrate.ts up",
    "dev:migrate:down": "tsx src/data/migrate.ts down",
    "seed:staging": "bash scripts/seed-secrets.sh --env staging",
    "seed:production": "bash scripts/seed-secrets.sh --env production",
    "seed:staging:dry": "bash scripts/seed-secrets.sh --env staging --dry-run",
    "seed:production:dry": "bash scripts/seed-secrets.sh --env production --dry-run",
    "chart:lint": "helm lint chart",
    "chart:template:staging": "helm template digest-pipeline chart -f chart/values-staging.yaml",
    "chart:template:production": "helm template digest-pipeline chart -f chart/values-production.yaml",
    "chart:check-env": "node scripts/check-chart-env-covers-config.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@linear/sdk": "^88.0.0",
    "@notionhq/client": "^5.0.0",
    "@octokit/rest": "^22.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation-pino": "^0.66.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@slack/web-api": "^7.8.0",
    "@smithy/node-http-handler": "^4.7.3",
    "dotenv": "^17.4.0",
    "fastify": "^5.2.0",
    "jose": "^6.2.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "source-map-support": "^0.5.21",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "gaxios": "^7.3.0",
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6",
    "protobufjs": "^7.6.4",
    "vite": "^8.0.16"
  }
}
